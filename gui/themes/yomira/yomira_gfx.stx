<render_info>
	<palette>
		<!-- Surfaces -->
		<color name = 'background'
				rgb = '30, 32, 48'
		/>
		<color name = 'dialog_background'
				rgb = '42, 45, 66'
		/>
		<color name = 'tab_inactive'
				rgb = '37, 40, 57'
		/>
		<color name = 'field'
				rgb = '23, 25, 39'
		/>
		<color name = 'thumb_color'
				rgb = '23, 25, 39'
		/>
		<color name = 'shadow'
				rgb = '14, 15, 24'
		/>

		<!-- Buttons -->
		<color name = 'button_idle'
				rgb = '52, 56, 79'
		/>
		<color name = 'button_hover'
				rgb = '62, 66, 92'
		/>
		<color name = 'button_pressed'
				rgb = '217, 115, 154'
		/>
		<color name = 'button_disabled'
				rgb = '42, 45, 66'
		/>

		<!-- Lines -->
		<color name = 'border'
				rgb = '68, 72, 106'
		/>
		<color name = 'border_disabled'
				rgb = '56, 59, 82'
		/>

		<!-- Text -->
		<color name = 'text'
				rgb = '230, 230, 240'
		/>
		<color name = 'text_dim'
				rgb = '154, 157, 181'
		/>
		<color name = 'text_disabled'
				rgb = '90, 93, 114'
		/>
		<color name = 'text_on_accent'
				rgb = '30, 32, 48'
		/>

		<!-- Accent -->
		<color name = 'accent'
				rgb = '242, 143, 176'
		/>
		<color name = 'accent_hover'
				rgb = '246, 169, 195'
		/>
		<color name = 'accent_muted'
				rgb = '201, 138, 163'
		/>
	</palette>

	<bitmaps>
		<bitmap filename = 'logo.bmp' scalable_file = 'logo.svg' width = '287' height = '80'/>
		<bitmap filename = 'logo_small.bmp' scalable_file = 'logo.svg' width = '144' height = '40'/>
		<bitmap filename = 'cursor.bmp' scalable_file = 'cursor.svg' width = '24' height = '24'/>
		<bitmap filename = 'cursor_small.bmp' scalable_file = 'cursor.svg' width = '16' height = '16'/>
		<bitmap filename = 'cursor-index.bmp' scalable_file = 'cursor-index.svg' width = '24' height = '24'/>
		<bitmap filename = 'cursor-index_small.bmp' scalable_file = 'cursor-index.svg' width = '16' height = '16'/>
		<bitmap filename = 'checkbox.bmp' scalable_file = 'checkbox.svg' width = '15' height = '15'/>
		<bitmap filename = 'checkbox_empty.bmp' scalable_file = 'checkbox_empty.svg' width = '15' height = '15'/>
		<bitmap filename = 'checkbox_disabled.bmp' scalable_file = 'checkbox_disabled.svg' width = '15' height = '15'/>
		<bitmap filename = 'checkbox_disabled_empty.bmp' scalable_file = 'checkbox_disabled_empty.svg' width = '15' height = '15'/>
		<bitmap filename = 'radiobutton.bmp' scalable_file = 'radiobutton.svg' width = '15' height = '15'/>
		<bitmap filename = 'radiobutton_empty.bmp' scalable_file = 'radiobutton_empty.svg' width = '15' height = '15'/>
		<bitmap filename = 'radiobutton_disabled.bmp' scalable_file = 'radiobutton_disabled.svg' width = '15' height = '15'/>
		<bitmap filename = 'search.bmp' scalable_file = 'search.svg' width = '16' height = '16'/>
		<bitmap filename = 'eraser.bmp' scalable_file = 'eraser.svg' width = '16' height = '16'/>
		<bitmap filename = 'delbtn.bmp' scalable_file = 'delbtn.svg' width = '16' height = '16'/>
		<bitmap filename = 'list.bmp' scalable_file = 'list.svg' width = '16' height = '16'/>
		<bitmap filename = 'grid.bmp' scalable_file = 'grid.svg' width = '16' height = '16'/>
		<bitmap filename = 'stopbtn.bmp' scalable_file = 'stopbtn.svg' width = '32' height = '32'/>
		<bitmap filename = 'editbtn.bmp' scalable_file = 'editbtn.svg' width = '32' height = '32'/>
		<bitmap filename = 'switchbtn.bmp' scalable_file = 'switchbtn.svg' width = '32' height = '32'/>
		<bitmap filename = 'fastreplay.bmp' scalable_file = 'fastreplay.svg' width = '32' height = '32'/>
		<bitmap filename = 'stopbtn_small.bmp' scalable_file = 'stopbtn.svg' width = '16' height = '16'/>
		<bitmap filename = 'editbtn_small.bmp' scalable_file = 'editbtn.svg' width = '16' height = '16'/>
		<bitmap filename = 'switchbtn_small.bmp' scalable_file = 'switchbtn.svg' width = '16' height = '16'/>
		<bitmap filename = 'fastreplay_small.bmp' scalable_file = 'fastreplay.svg' width = '16' height = '16'/>
		<bitmap filename = 'button_play.bmp' scalable_file = 'button_play.svg' width = '15' height = '15'/>
		<bitmap filename = 'button_load.bmp' scalable_file = 'button_load.svg' width = '15' height = '15'/>
		<bitmap filename = 'button_options.bmp' scalable_file = 'button_options.svg' width = '15' height = '15'/>
		<bitmap filename = 'groupbtn.bmp' scalable_file = 'groupbtn.svg' width = '16' height = '16'/>
	</bitmaps>

	<fonts>
		<font	resolution = 'y>=H'
				id = 'text_default'
				file = 'helvb12.bdf'
				point_size = '12'>
				<!-- Add these in order of priority. First match is used -->
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf' fallback_file = 'LiberationSans-Regular.ttf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = '*' scalable_file = 'NotoSansJP-Regular.otf' fallback_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	id = 'text_default'
				file = 'clR6x12.bdf'
				point_size = '11'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf'/>
				<language id = '*' scalable_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	resolution = 'y>=H'
				id = 'text_button'
				file = 'helvb12.bdf'
				point_size = '12'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Bold.otf' fallback_file = 'LiberationSans-Bold.ttf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Bold.otf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Bold.otf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Bold.otf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Bold.ttf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Bold.ttf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Bold.ttf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Bold.ttf' fallback_file = 'NotoSansJP-Bold.otf'/>
				<language id = '*' scalable_file = 'NotoSansJP-Bold.otf' fallback_file = 'LiberationSans-Bold.ttf'/>
		</font>
		<font	id = 'text_button'
				file = 'clR6x12.bdf'
				point_size = '11'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf'/>
				<language id = '*' scalable_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	resolution = 'y>=H'
				id = 'text_normal'
				file = 'helvb12.bdf'
				point_size = '12'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf' fallback_file = 'LiberationSans-Regular.ttf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = '*' scalable_file = 'NotoSansJP-Regular.otf' fallback_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	id = 'text_normal'
				file = 'clR6x12.bdf'
				point_size = '11'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf'/>
				<language id = '*' scalable_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	resolution = 'y>=H'
				id = 'tooltip_normal'
				file = 'helvb12.bdf'
				point_size = '11'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf' fallback_file = 'LiberationSans-Regular.ttf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf' fallback_file = 'NotoSansJP-Regular.otf'/>
				<language id = '*' scalable_file = 'NotoSansJP-Regular.otf' fallback_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	id = 'tooltip_normal'
				file = 'clR6x12.bdf'
				point_size = '11'>
				<language id = 'ja' scalable_file = 'NotoSansJP-Regular.otf'/>
				<language id = 'ko' scalable_file = 'NotoSansKR-Regular.otf'/>
				<language id = 'zh_Hans' scalable_file = 'NotoSansSC-Regular.otf'/>
				<language id = 'zh_Hant' scalable_file = 'NotoSansTC-Regular.otf'/>
				<language id = 'hi' scalable_file = 'NotoSans-Regular.ttf'/>
				<language id = 'ar' scalable_file = 'NotoNaskhArabic-Regular.ttf'/>
				<language id = 'he' scalable_file = 'NotoSansHebrew-Regular.ttf'/>
				<language id = 'ka' scalable_file = 'NotoSansGeorgian-Regular.ttf'/>
				<language id = '*' scalable_file = 'LiberationSans-Regular.ttf'/>
		</font>
		<font	resolution = 'y>799'
				id = 'console'
				file = 'builtinConsole'
				point_size = '12'>
				<language id = '*'   scalable_file = 'SourceCodeVariable-Roman.ttf'/>
		</font>
		<font	resolution = 'y>=H'
				id = 'console'
				file = 'builtinConsole'
				point_size = '10'>
				<language id = '*'   scalable_file = 'SourceCodeVariable-Roman.ttf'/>
		</font>
		<font	id = 'console'
				file = 'builtinConsole'
				point_size = '8'>
				<language id = '*'   scalable_file = 'SourceCodeVariable-Roman.ttf'/>
		</font>

		<text_color	id = 'color_normal'
				color = 'text'
		/>
		<text_color	id = 'color_normal_inverted'
				color = 'text_on_accent'
		/>
		<text_color	id = 'color_normal_hover'
				color = 'accent_hover'
		/>
		<text_color	id = 'color_normal_disabled'
				color = 'text_disabled'
		/>
		<text_color	id = 'color_alternative'
				color = 'text_dim'
		/>
		<text_color	id = 'color_alternative_inverted'
				color = 'text_on_accent'
		/>
		<text_color	id = 'color_alternative_hover'
				color = 'text'
		/>
		<text_color	id = 'color_alternative_disabled'
				color = 'text_disabled'
		/>
		<text_color	id = 'color_override'
				color = 'accent'
		/>
		<text_color	id = 'color_override_inverted'
				color = 'text_on_accent'
		/>
		<text_color	id = 'color_override_hover'
				color = 'accent_hover'
		/>
		<text_color	id = 'color_override_disabled'
				color = 'text_disabled'
		/>
		<text_color	id = 'color_button'
				color = 'text'
		/>
		<text_color	id = 'color_button_hover'
				color = 'text'
		/>
		<text_color	id = 'color_button_disabled'
				color = 'text_disabled'
		/>
	</fonts>

	<cursor file = 'cursor.bmp' hotspot = '0, 0'/>
	<cursor resolution = 'y<H' file = 'cursor_small.bmp' hotspot = '0, 0'/>
	<cursor file = 'cursor-index.bmp' hotspot = '0, 0' type = 'index'/>
	<cursor resolution = 'y<H' file = 'cursor-index_small.bmp' hotspot = '0, 0' type = 'index'/>

	<!-- Selection (text or list items) without focus -->
	<drawdata id = 'text_selection' cache = 'false'>
		<drawstep	func = 'square'
					fill = 'foreground'
					fg_color = 'accent_muted'
		/>
	</drawdata>

	<!-- Selection (text or list items) with focus -->
	<drawdata id = 'text_selection_focus' cache = 'false'>
		<drawstep	func = 'square'
					fill = 'foreground'
					fg_color = 'accent'
		/>
	</drawdata>

	<!-- Launcher background -->
	<drawdata id = 'mainmenu_bg' cache = 'false'>
		<drawstep	func = 'fill'
					fill = 'background'
					bg_color = 'background'
		/>
	</drawdata>

	<!-- Global main menu and load screen -->
	<drawdata id = 'special_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '8'
					fill = 'background'
					bg_color = 'dialog_background'
					stroke = '1'
					fg_color = 'border'
					shadow = '4'
		/>
	</drawdata>

	<!-- Choosers (file browser, theme browser, ...) -->
	<drawdata id = 'plain_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '8'
					fill = 'background'
					bg_color = 'dialog_background'
					stroke = '1'
					fg_color = 'border'
					shadow = '4'
		/>
	</drawdata>

	<!-- Dialogs, tab contents and game picker -->
	<drawdata id = 'default_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '8'
					fill = 'background'
					bg_color = 'dialog_background'
					stroke = '1'
					fg_color = 'border'
					shadow = '4'
		/>
	</drawdata>

	<!-- Tooltip -->
	<drawdata id = 'tooltip_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '4'
					fill = 'background'
					bg_color = 'dialog_background'
					stroke = '1'
					fg_color = 'accent'
					shadow = '2'
		/>
	</drawdata>

	<!-- Separator in popup lists -->
	<drawdata id = 'separator' cache = 'false'>
		<drawstep	func = 'square'
					fill = 'foreground'
					height = '1'
					ypos = 'center'
					fg_color = 'border'
		/>
	</drawdata>

	<!-- Cursor in the text edit widget -->
	<drawdata id = 'caret' cache = 'false'>
		<drawstep	func = 'square'
					fill = 'foreground'
					fg_color = 'accent'
		/>
	</drawdata>

	<!-- Background of the thumbnail -->
	<drawdata id = 'thumb_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '5'
					fill = 'background'
					bg_color = 'thumb_color'
					stroke = '0'
		/>
	</drawdata>

	<!-- Grid view item -->
	<drawdata id = 'griditem_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '6'
					fill = 'background'
					bg_color = 'dialog_background'
					stroke = '0'
		/>
	</drawdata>

	<!-- Hovered grid view item -->
	<drawdata id = 'griditem_hover_bg' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '6'
					fill = 'background'
					bg_color = 'dialog_background'
					stroke = '2'
					fg_color = 'accent'
		/>
	</drawdata>

	<!-- Background of the list widget -->
	<drawdata id = 'widget_default' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '6'
					fill = 'background'
					bg_color = 'field'
					stroke = '1'
					fg_color = 'border'
					shadow = '0'
		/>
	</drawdata>

	<!-- Background of small widgets -->
	<drawdata id = 'widget_small' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '4'
					fill = 'background'
					bg_color = 'field'
					stroke = '0'
		/>
	</drawdata>

	<!-- Background of the textedit widget -->
	<drawdata id = 'widget_textedit' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '4'
					fill = 'background'
					bg_color = 'field'
					stroke = '1'
					fg_color = 'border'
					shadow = '0'
		/>
	</drawdata>

	<!-- Background of the scrollbar -->
	<drawdata id = 'scrollbar_base' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '4'
					fill = 'background'
					bg_color = 'field'
					stroke = '0'
		/>
	</drawdata>

	<!-- Handle of the scrollbar -->
	<drawdata id = 'scrollbar_handle_idle' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '4'
					fill = 'foreground'
					stroke = '0'
					fg_color = 'border'
					padding = '2, 0, 2, 0'
		/>
	</drawdata>

	<drawdata id = 'scrollbar_handle_hover' cache = 'false'>
		<drawstep	func = 'roundedsq'
					radius = '4'
					fill = 'foreground'
					stroke = '0'
					fg_color = 'accent'
					padding = '2, 0, 2, 0'
		/>
	</drawdata>

	<!-- Buttons at the top and bottom of the scrollbar -->
	<drawdata id = 'scrollbar_button_idle' cache = 'false' resolution = 'y>=H'>
		<drawstep	func = 'triangle'
					fg_color = 'text_dim'
					fill = 'foreground'
					width = '8'
					height = '8'
					xpos = 'right'
					ypos = 'center'
					padding = '0,0,3,0'
					orientation = 'top'
		/>
	</drawdata>

	<drawdata id = 'scrollbar_button_idle' cache = 'false' resolution = 'y<H'>
		<drawstep	func = 'triangle'
					fg_color = 'text_dim'
					fill = 'foreground'
					width = '5'
					height = '5'
					xpos = 'right'
					ypos = 'center'
					padding = '0,0,1,0'
					orientation = 'top'
		/>
	</drawdata>

	<drawdata id = 'scrollbar_button_hover' cache = 'false' resolution = 'y>=H'>
		<drawstep	func = 'triangle'
					fg_color = 'accent'
					fill = 'foreground'
					width = '8'
					height = '8'
					xpos = 'right'
					ypos = 'center'
					padding = '0,0,3,0'
					orientation = 'top'
		/>
